# Supabase Configuration
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-key-here

# LLM Proxy URL (for production, use your deployed proxy URL)
VITE_LLM_PROXY_URL=http://localhost:3000

# Chat feature toggle (set to false to disable chat in production)
VITE_CHAT_ENABLED=true

# User Tier (for MVP, hardcoded)
# Options: free, premium, pro
VITE_USER_TIER=free

# Chat Feature Toggle (GitHub Pages deploys set this to false)
VITE_CHAT_ENABLED=true

# User Tier (for MVP, hardcoded)
# Options: free, premium, pro
VITE_USER_TIER=free

# === Alternative Provider Examples ===

# OpenAI Configuration:
# VITE_LLM_PROVIDER=openai
# VITE_LLM_MODEL=gpt-4o
# VITE_LLM_API_KEY=sk-xxx
# VITE_LLM_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration:
# VITE_LLM_PROVIDER=anthropic
# VITE_LLM_MODEL=claude-3-5-sonnet-20241022
# VITE_LLM_API_KEY=sk-ant-xxx

# Ollama (Local) Configuration:
# VITE_LLM_PROVIDER=ollama
# VITE_LLM_MODEL=llama3.1:70b
# VITE_LLM_BASE_URL=http://localhost:11434
